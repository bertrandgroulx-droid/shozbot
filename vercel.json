{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/statterbrain",
      "destination": "/statterbrain/",
      "permanent": false
    },
    {
      "source": "/better-weather",
      "destination": "/better-weather/",
      "permanent": false
    },
    {
      "source": "/mogo",
      "destination": "/mogo/",
      "permanent": false
    },
    {
      "source": "/word-square",
      "destination": "/word-square/",
      "permanent": false
    },
    {
      "source": "/word-ninja",
      "destination": "/word-ninja/",
      "permanent": false
    },
    {
      "source": "/letter-drop",
      "destination": "/letter-drop/",
      "permanent": false
    },
    {
      "source": "/fauxcabulary",
      "destination": "/fauxcabulary/",
      "permanent": false
    },
    {
      "source": "/acronumbskull",
      "destination": "/acronumbskull/",
      "permanent": false
    },
    {
      "source": "/would-you-rather",
      "destination": "/would-you-rather/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/statterbrain/",
      "destination": "https://statterbrain.vercel.app/"
    },
    {
      "source": "/statterbrain/:path*",
      "destination": "https://statterbrain.vercel.app/:path*"
    },
    {
      "source": "/better-weather/",
      "destination": "https://bertrandgroulx-droid.github.io/better-weather/"
    },
    {
      "source": "/better-weather/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/better-weather/:path*"
    },
    {
      "source": "/mogo/",
      "destination": "https://bertrandgroulx-droid.github.io/mogo/"
    },
    {
      "source": "/mogo/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/mogo/:path*"
    },
    {
      "source": "/word-square/",
      "destination": "https://bertrandgroulx-droid.github.io/word-square/"
    },
    {
      "source": "/word-square/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/word-square/:path*"
    },
    {
      "source": "/word-ninja/",
      "destination": "https://bertrandgroulx-droid.github.io/word-ninja/"
    },
    {
      "source": "/word-ninja/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/word-ninja/:path*"
    },
    {
      "source": "/letter-drop/",
      "destination": "https://bertrandgroulx-droid.github.io/letter_drop/"
    },
    {
      "source": "/letter-drop/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/letter_drop/:path*"
    },
    {
      "source": "/fauxcabulary/",
      "destination": "https://bertrandgroulx-droid.github.io/fauxcabulary/"
    },
    {
      "source": "/fauxcabulary/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/fauxcabulary/:path*"
    },
    {
      "source": "/acronumbskull/",
      "destination": "https://bertrandgroulx-droid.github.io/acronumbskull/"
    },
    {
      "source": "/acronumbskull/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/acronumbskull/:path*"
    },
    {
      "source": "/would-you-rather/",
      "destination": "https://bertrandgroulx-droid.github.io/would-you-rather/"
    },
    {
      "source": "/would-you-rather/:path*",
      "destination": "https://bertrandgroulx-droid.github.io/would-you-rather/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
